/android/.gradle/
/android/app/build/
/android/build/

# Node
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Env
.env
.env.*
*.key
*.pem

# VS Code settings
.vscode/

# macOS
.DS_Store

# Build outputs
/build/
/out/

